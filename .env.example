# OpenRouter API key for local AI map generation.
# Copy this file to .env and replace the placeholder with your key.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter model used by the server-side AI map generation service.
OPENROUTER_MODEL=inclusionai/ling-3.0-flash

# Optional: URL shown to OpenRouter for request identification.
APP_URL=http://localhost:5173
